{% extends 'base.html.twig' %}

{% block title %}Maison Éclat — L'art de prendre soin de soi{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap');

    :root {
        --cream: #f8f5ef;
        --beige: #e9dfd2;
        --brown: #49372e;
        --dark: #30241f;
        --muted: #82766d;
        --white: #fffefa;
        --line: #e6ddd3;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
        margin: 0;
        background: var(--cream);
        color: var(--dark);
        font-family: 'DM Sans', sans-serif;
    }

    a { color: inherit; text-decoration: none; }

    img {
        display: block;
        width: 100%;
        object-fit: cover;
    }

    .announcement {
        background: var(--brown);
        color: white;
        text-align: center;
        padding: 10px 16px;
        font-size: 11px;
        letter-spacing: 1.4px;
    }

    .site-header {
        background: var(--white);
        padding: 0 6%;
        border-bottom: 1px solid var(--line);
    }

    .header-main {
        min-height: 72px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 24px;
        letter-spacing: .4px;
        white-space: nowrap;
        color: var(--brown);
    }

    .brand-mark {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
    }

    .brand-name { display: block; }
    .brand-tagline {
        display: block;
        margin-top: 3px;
        color: #96754b;
        font: 9px 'DM Sans', sans-serif;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .footer-brand-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #f8f2e9;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 23px;
    }

    .footer-brand-logo .brand-mark { width: 36px; height: 36px; flex-basis: 36px; }
    .footer-brand-logo .brand-tagline { color: #c6a77f; }

    .main-nav {
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 12px;
        color: #62544c;
    }

    .main-nav a:hover { color: #a67d65; }

    .header-link {
        font-size: 12px;
        border-bottom: 1px solid var(--brown);
        padding-bottom: 5px;
        white-space: nowrap;
    }

    /* HERO : un seul fond continu, image bien cadrée à droite */
    .hero {
        position: relative;
        display: flex;
        align-items: center;
        height: 540px;
        background: #eae0d4;
        overflow: hidden;
    }

    .eyebrow {
        font-size: 11px;
        letter-spacing: 2.4px;
        text-transform: uppercase;
        color: #846b5b;
        font-weight: 600;
    }

    .hero-copy {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        width: 55%;
        padding: 40px 0 40px 7%;
    }

    .hero h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(38px, 4.2vw, 62px);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: -1.2px;
        max-width: 640px;
        margin: 18px 0 18px;
    }

    .hero-copy p {
        max-width: 460px;
        font-size: 15px;
        line-height: 1.75;
        color: #6c5d53;
        margin: 0 0 26px;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--brown);
        color: white;
        padding: 17px 28px;
        font-family: inherit;
        font-size: 12px;
        letter-spacing: .5px;
        border: 1px solid var(--brown);
        transition: background .2s, color .2s;
    }

    .button:hover {
        background: transparent;
        color: var(--brown);
    }

    /* Image collée en bas, à hauteur du hero, avec une marge à droite */
    .hero-image {
        position: absolute;
        bottom: 0;
        right: -8vw;
        height: 100%;
        z-index: 1;
    }

    .hero-image img {
        width: auto;
        height: 100%;
        max-width: none;
        object-fit: contain;
        object-position: right bottom;
    }

    .intro {
        text-align: center;
        padding: 52px 20px 24px;
    }

    .intro h2,
    .section-heading h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 400;
        font-size: clamp(30px, 3vw, 41px);
        margin: 14px 0;
        letter-spacing: -.5px;
    }

    .intro p,
    .section-heading p {
        font-size: 12px;
        line-height: 1.9;
        color: var(--muted);
        max-width: 500px;
        margin: 0 auto;
    }

    .categories {
        padding: 10px 6% 56px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .category-card { min-width: 0; }

    .category-image {
        height: 300px;
        overflow: hidden;
        background: var(--beige);
    }

    .category-image img {
        height: 100%;
        transition: transform .5s ease;
    }

    .category-card:hover .category-image img {
        transform: scale(1.04);
    }

    .category-meta {
        padding: 19px 2px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .category-meta h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 21px;
        font-weight: 400;
        margin: 0;
    }

    .category-meta span {
        font-size: 20px;
        color: #927661;
    }

    .products-section {
        background: #eee7de;
        padding: 56px 6%;
    }

    .section-heading {
        text-align: center;
        margin-bottom: 30px;
    }

    .products {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .product-card {
        background: var(--white);
        min-width: 0;
    }

    .product-image {
        height: 300px;
        position: relative;
        overflow: hidden;
        background: #e8ded3;
    }

    .product-image img {
        height: 100%;
        transition: transform .4s ease;
    }

    .product-card:hover .product-image img {
        transform: scale(1.035);
    }

    .product-tag {
        position: absolute;
        top: 14px;
        left: 14px;
        background: var(--white);
        padding: 7px 10px;
        font-size: 9px;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .product-info {
        padding: 20px 18px 23px;
    }

    .product-category {
        color: var(--muted);
        text-transform: uppercase;
        font-size: 9px;
        letter-spacing: 1.4px;
    }

    .product-info h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 19px;
        font-weight: 400;
        margin: 9px 0;
    }

    .product-description {
        font-size: 11px;
        color: var(--muted);
        line-height: 1.8;
        min-height: 38px;
    }

    .product-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-top: 1px solid var(--line);
        padding-top: 15px;
        margin-top: 14px;
    }

    .price {
        font-size: 13px;
        font-weight: 600;
    }

    .product-link {
        font-size: 10px;
        border-bottom: 1px solid var(--brown);
        padding-bottom: 4px;
    }

    .editorial {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--white);
    }

    .editorial-image {
        min-height: 430px;
        overflow: hidden;
    }

    .editorial-image img {
        height: 100%;
        min-height: 430px;
    }

    .editorial-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 65px 12%;
    }

    .editorial-copy h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(34px, 3.5vw, 48px);
        line-height: 1.2;
        font-weight: 400;
        margin: 20px 0;
    }

    .editorial-copy p {
        font-size: 12px;
        line-height: 2;
        color: var(--muted);
        margin: 0 0 20px;
    }

    .newsletter {
        text-align: center;
        padding: 56px 20px;
        background: #e9dfd3;
    }

    .newsletter h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 32px;
        font-weight: 400;
        margin: 12px 0;
    }

    .newsletter p {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
    }

    .site-footer {
        background: var(--dark);
        color: #f8f2e9;
        padding: 45px 6% 25px;
    }

    .footer-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 30px;
        flex-wrap: wrap;
        padding-bottom: 35px;
    }

    .footer-brand {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 25px;
    }

    .footer-main p {
        color: #c9bcb1;
        font-size: 11px;
        line-height: 1.8;
        max-width: 300px;
    }

    .footer-links {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 11px;
        color: #e2d7cd;
    }

    .footer-bottom {
        border-top: 1px solid #51443c;
        padding-top: 20px;
        font-size: 10px;
        color: #c9bcb1;
        display: flex;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
    }

    @media (max-width: 850px) {
        .main-nav { gap: 14px; }
        .hero-copy { padding: 36px 0 36px 6%; width: 60%; }
        .hero-image { right: -12vw; }
        .category-image, .product-image { height: 240px; }
    }

    @media (max-width: 650px) {
        .header-main {
            padding: 20px 0;
            flex-direction: column;
        }

        .main-nav {
            justify-content: center;
            flex-wrap: wrap;
            font-size: 11px;
        }

        .header-link { display: none; }

        .hero {
            display: flex;
            flex-direction: column;
            height: auto;
        }

        .hero-copy {
            width: 100%;
            padding: 36px 8% 20px;
            text-align: center;
            align-items: center;
        }

        .hero h1 { font-size: clamp(34px, 9vw, 46px); }

        .hero-copy p { font-size: 13px; }

        .hero-image {
            position: static;
            height: 340px;
            width: 100%;
            overflow: hidden;
        }

        .hero-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: 68% bottom;
        }

        .categories, .products {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .category-image, .product-image { height: 340px; }

        .editorial { grid-template-columns: 1fr; }

        .editorial-image, .editorial-image img { min-height: 320px; }

        .editorial-copy { padding: 45px 8%; }

        .intro { padding-top: 44px; }

        .products-section { padding: 48px 7%; }
    }


    /* Bouton panier dans l'en-tête */
    .cart-button {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border: none;
        background: transparent;
        color: var(--brown);
        cursor: pointer;
        transition: opacity .2s ease;
    }

    .cart-button:hover {
        opacity: .65;
    }

    .cart-count {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 50%;
        background: var(--brown);
        color: white;
        font-size: 9px;
    }

    /* Fond sombre derrière le panier */
    .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .35);
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: .3s;
    }

    .cart-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    /* Panneau latéral */
    .cart-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 420px;
        max-width: 100%;
        height: 100vh;
        background: var(--white);
        z-index: 1001;
        padding: 28px;
        transform: translateX(100%);
        transition: transform .3s ease;
        display: flex;
        flex-direction: column;
    }

    .cart-panel.active {
        transform: translateX(0);
    }

    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--line);
        padding-bottom: 18px;
    }

    .cart-header h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 400;
    }

    .cart-close {
        border: none;
        background: none;
        font-size: 26px;
        cursor: pointer;
        color: var(--brown);
    }

    .cart-items {
        flex: 1;
        overflow-y: auto;
        padding: 15px 0;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 76px minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        padding: 15px 0;
        border-bottom: 1px solid var(--line);
    }

    .cart-product-image {
        width: 76px;
        height: 88px;
        object-fit: cover;
        border-radius: 4px;
        margin: 0;
    }

    .cart-product-details { min-width: 0; }
    .cart-product-details h3 { margin: 0 0 6px; }
    .cart-product-details p { margin: 4px 0; }
    .cart-quantity {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
    }
    .cart-quantity button {
        width: 27px;
        height: 27px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--brown);
        cursor: pointer;
        font-size: 16px;
    }
    .cart-delete {
        border: 0;
        background: transparent;
        color: #986b58;
        cursor: pointer;
        padding: 8px;
    }
    .cart-delete svg { width: 19px; height: 19px; display: block; }


    .cart-item h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 400;
        font-size: 17px;
    }

    .cart-item p {
        font-size: 12px;
        color: var(--muted);
    }


    .cart-footer {
        border-top: 1px solid var(--line);
        padding-top: 18px;
    }

    .cart-total {
        display: flex;
        justify-content: space-between;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .cart-empty {
        color: var(--muted);
        text-align: center;
        padding: 35px 0;
    }

    .cart-validate {
        width: 100%;
        border: 1px solid var(--brown);
        background: var(--brown);
        color: white;
        padding: 14px 18px;
        cursor: pointer;
        font: inherit;
        font-size: 11px;
        letter-spacing: .5px;
    }

    .add-cart-button {
        border: 1px solid var(--brown);
        background: var(--brown);
        color: white;
        padding: 10px 13px;
        cursor: pointer;
        font-family: inherit;
        font-size: 10px;
    }

    .add-cart-button:hover {
        background: transparent;
        color: var(--brown);
    }

    @media (max-width: 650px) {
        .cart-panel {
            width: 100%;
        }
    }

</style>

<div class="announcement">
    UNE BEAUTÉ QUI VOUS RESSEMBLE · DES RITUELS PENSÉS POUR VOUS
</div>

<header class="site-header">
    <div class="header-main">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Maison Éclat, accueil">
            <svg class="brand-mark" viewBox="0 0 48 48" role="img" aria-label="Emblème floral">
                <g fill="none" stroke="#96754b" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 4 C19 11 19 16 24 20 C29 16 29 11 24 4Z"/>
                    <path d="M24 20 C17 14 12 15 11 21 C16 26 21 25 24 20Z"/>
                    <path d="M24 20 C31 14 36 15 37 21 C32 26 27 25 24 20Z"/>
                    <path d="M24 20 C18 25 18 31 24 35 C30 31 30 25 24 20Z"/>
                    <path d="M24 35 L24 43 M19 39 L24 35 L29 39"/>
                    <circle cx="24" cy="20" r="2.1"/>
                </g>
            </svg>
            <span>
                <span class="brand-name">Maison Éclat</span>
                <span class="brand-tagline">Beauté · Soin · Éclat</span>
            </span>
        </a>

        <nav class="main-nav" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="#categories">Nos univers</a>
            <a href="#produits">Nos produits</a>
            <a href="#histoire">Notre philosophie</a>
        </nav>

        <a class="header-link" href="#produits">Découvrir la collection</a>

            <button type="button" class="cart-button" id="openCart" aria-label="Ouvrir le panier">
                    <svg viewBox="0 0 24 24" width="23" height="23" fill="none"
                        stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 7H6"/>
                        <circle cx="10" cy="20" r="1"/>
                        <circle cx="18" cy="20" r="1"/>
                    </svg>
                <span class="cart-count" id="cartCount">0</span>
            </button>
    </div>
</header>

<main>
    <section class="hero">
        <div class="hero-copy">
            <span class="eyebrow">L'élégance au quotidien</span>

            <h1>Le luxe de prendre soin de soi au quotidien</h1>

            <p>
                Des essentiels beauté soigneusement sélectionnés,
                des textures délicates et des rituels qui transforment
                les petits gestes en véritables moments pour soi
            </p>

            <a class="button" href="#produits">Explorer la collection</a>
        </div>

        <div class="hero-image">
            <img
                src="{{ asset('maison-eclat-femme.png') }}"
                alt="Une femme aux cheveux bouclés applique sa crème de soin"
                fetchpriority="high"
            >
        </div>
    </section>

    <section id="categories">
        <div class="intro">
            <span class="eyebrow">L'art du soin</span>
            <h2>Découvrez nos univers</h2>
            <p>
                Des indispensables sélectionnés pour accompagner
                chaque moment de votre routine beauté.
            </p>
        </div>

        <div class="categories">
            <a class="category-card" href="#produits">
                <div class="category-image">
                    <img
                        src="https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&fit=crop&w=850&q=85"
                        alt="Soins et cosmétiques pour le visage"
                        loading="lazy"
                    >
                </div>
                <div class="category-meta">
                    <h3>Soins du visage</h3>
                    <span aria-hidden="true">↗</span>
                </div>
            </a>

            <a class="category-card" href="#produits">
                <div class="category-image">
                    <img
                        src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=850&q=85"
                        alt="Univers du maquillage"
                        loading="lazy"
                    >
                </div>
                <div class="category-meta">
                    <h3>Maquillage</h3>
                    <span aria-hidden="true">↗</span>
                </div>
            </a>

            <a class="category-card" href="#produits">
                <div class="category-image">
                    <img
                        src="https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=850&q=85"
                        alt="Produits de soin et de bien-être"
                        loading="lazy"
                    >
                </div>
                <div class="category-meta">
                    <h3>Soins du corps</h3>
                    <span aria-hidden="true">↗</span>
                </div>
            </a>
        </div>
    </section>

    <section class="products-section" id="produits">
        <div class="section-heading">
            <span class="eyebrow">Nos essentiels</span>
            <h2>La sélection beauté</h2>
            <p>
                Quelques incontournables pour commencer votre rituel.
                Les références ci-dessous sont provisoires.
            </p>
        </div>


       <div class="products">



    {# Produits récupérés depuis Strapi #}
    {% for produit in produits %}
        {% set photo = produit.images|default([])|first %}

        <article class="product-card">
            <div class="product-image">
                {% if photo and photo.url is defined %}
                    <img
                        src="http://localhost:1337{{ photo.url }}"
                        alt="{{ produit.titre|default('Produit beauté') }}"
                        loading="lazy"
                    >
                {% else %}
                    <img
                        src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=800&q=85"
                        alt="Produit de beauté"
                        loading="lazy"
                    >
                {% endif %}

                <span class="product-tag">Les essentiels</span>
            </div>

            <div class="product-info">
                <span class="product-category">Soins de beauté</span>

                <h3>{{ produit.titre|default('Produit beauté') }}</h3>

                <p class="product-description">
                    {{ produit.description|default('Découvrez cet essentiel beauté.') }}
                </p>

                <div class="product-bottom">
                    <span class="price">
                        {{ produit.prix|default(0)|number_format(2, ',', ' ') }} €
                    </span>
                    <a href="#categories" class="product-link">
                        En savoir plus ↗
                    </a>
                </div>
                <div style="margin-top: 12px;">
                    <button
                        type="button"
                        class="add-cart-button"
                        data-document-id="{{ produit.documentId }}"
                        aria-label="Ajouter {{ produit.titre|default('ce produit') }} au panier">
                        Ajouter au panier
                    </button>
                </div>
            </div>
        </article>
    {% else %}
        <p>Les produits ne sont pas disponibles pour le moment.</p>
       {% endfor %}

</div>
    </section>

    <section class="newsletter">
        <span class="eyebrow">Un instant pour vous</span>
        <h2>Bienvenue dans notre univers.</h2>
        <p>
