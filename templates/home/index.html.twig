                        <path d="M24 20 C17 14 12 15 11 21 C16 26 21 25 24 20Z"/>
                        <path d="M24 20 C31 14 36 15 37 21 C32 26 27 25 24 20Z"/>
                        <path d="M24 20 C18 25 18 31 24 35 C30 31 30 25 24 20Z"/>
                        <path d="M24 35 L24 43 M19 39 L24 35 L29 39"/>
