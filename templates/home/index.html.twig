
{% extends 'base.html.twig' %}

{% block title %}Maison Éclat — L'art de prendre soin de soi{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap');

    :root {
        --cream: #f8f5ef;
        --beige: #e9dfd2;
        --brown: #49372e;
        --dark: #30241f;
        --muted: #82766d;
        --white: #fffefa;
        --line: #e6ddd3;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
        margin: 0;
        background: var(--cream);
        color: var(--dark);
        font-family: 'DM Sans', sans-serif;
    }

    a { color: inherit; text-decoration: none; }

    img {
        display: block;
        width: 100%;
        object-fit: cover;
    }

    .announcement {
        background: var(--brown);
        color: white;
        text-align: center;
        padding: 10px 16px;
        font-size: 11px;
        letter-spacing: 1.4px;
    }

    .site-header {
        background: var(--white);
        padding: 0 6%;
        border-bottom: 1px solid var(--line);
    }

    .header-main {
        min-height: 86px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 24px;
        letter-spacing: .4px;
        white-space: nowrap;
        color: var(--brown);
    }

    .brand-mark {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
    }

    .brand-name { display: block; }
    .brand-tagline {
        display: block;
        margin-top: 3px;
        color: #96754b;
        font: 9px 'DM Sans', sans-serif;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .footer-brand-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #f8f2e9;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 23px;
    }

    .footer-brand-logo .brand-mark { width: 36px; height: 36px; flex-basis: 36px; }
    .footer-brand-logo .brand-tagline { color: #c6a77f; }

    .main-nav {
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 12px;
        color: #62544c;
    }

    .main-nav a:hover { color: #a67d65; }

    .header-link {
        font-size: 12px;
        border-bottom: 1px solid var(--brown);
        padding-bottom: 5px;
        white-space: nowrap;
    }

    .hero {
        display: grid;
        grid-template-columns: 0.88fr 1.12fr;
        min-height: 550px;
        background: #eae0d4;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 70px 12% 70px 13%;
    }

    .eyebrow {
        font-size: 10px;
        letter-spacing: 2.4px;
        text-transform: uppercase;
        color: #846b5b;
        font-weight: 600;
    }

    .hero h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(42px, 4.4vw, 65px);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: -1.5px;
        margin: 24px 0 20px;
    }

    .hero-copy p {
        max-width: 370px;
        font-size: 13px;
        line-height: 2;
        color: #6c5d53;
        margin: 0 0 25px;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--brown);
        color: white;
        padding: 16px 25px;
        font-family: inherit;
        font-size: 11px;
        letter-spacing: .7px;
        border: 1px solid var(--brown);
        transition: background .2s, color .2s;
    }

    .button:hover {
        background: transparent;
        color: var(--brown);
    }

    .hero-image {
        min-height: 550px;
        background: #d7c5b5;
        overflow: hidden;
    }

    .hero-image img {
        height: 100%;
        min-height: 550px;
        object-position: center;
    }

    .intro {
        text-align: center;
        padding: 76px 20px 38px;
    }

    .intro h2,
    .section-heading h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 400;
        font-size: clamp(30px, 3vw, 41px);
        margin: 14px 0;
        letter-spacing: -.5px;
    }

    .intro p,
    .section-heading p {
        font-size: 12px;
        line-height: 1.9;
        color: var(--muted);
        max-width: 500px;
        margin: 0 auto;
    }

    .categories {
        padding: 15px 6% 75px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .category-card { min-width: 0; }

    .category-image {
        height: 300px;
        overflow: hidden;
        background: var(--beige);
    }

    .category-image img {
        height: 100%;
        transition: transform .5s ease;
    }

    .category-card:hover .category-image img {
        transform: scale(1.04);
    }

    .category-meta {
        padding: 19px 2px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .category-meta h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 21px;
        font-weight: 400;
        margin: 0;
    }

    .category-meta span {
        font-size: 20px;
        color: #927661;
    }

    .products-section {
        background: #eee7de;
        padding: 75px 6%;
    }

    .section-heading {
        text-align: center;
        margin-bottom: 40px;
    }

    .products {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .product-card {
        background: var(--white);
        min-width: 0;
    }

    .product-image {
        height: 300px;
        position: relative;
        overflow: hidden;
        background: #e8ded3;
    }

    .product-image img {
        height: 100%;
        transition: transform .4s ease;
    }

    .product-card:hover .product-image img {
        transform: scale(1.035);
    }

    .product-tag {
        position: absolute;
        top: 14px;
        left: 14px;
        background: var(--white);
        padding: 7px 10px;
        font-size: 9px;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .product-info {
        padding: 20px 18px 23px;
    }

    .product-category {
        color: var(--muted);
        text-transform: uppercase;
        font-size: 9px;
        letter-spacing: 1.4px;
    }

    .product-info h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 19px;
        font-weight: 400;
        margin: 9px 0;
    }

    .product-description {
        font-size: 11px;
        color: var(--muted);
        line-height: 1.8;
        min-height: 38px;
    }

    .product-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-top: 1px solid var(--line);
        padding-top: 15px;
        margin-top: 14px;
    }

    .price {
        font-size: 13px;
        font-weight: 600;
    }

    .product-link {
        font-size: 10px;
        border-bottom: 1px solid var(--brown);
        padding-bottom: 4px;
    }

    .editorial {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--white);
    }

    .editorial-image {
        min-height: 430px;
        overflow: hidden;
    }

    .editorial-image img {
        height: 100%;
        min-height: 430px;
    }

    .editorial-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 65px 12%;
    }

    .editorial-copy h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(34px, 3.5vw, 48px);
        line-height: 1.2;
        font-weight: 400;
        margin: 20px 0;
    }

    .editorial-copy p {
        font-size: 12px;
        line-height: 2;
        color: var(--muted);
        margin: 0 0 20px;
    }

    .newsletter {
        text-align: center;
        padding: 70px 20px;
        background: #e9dfd3;
    }

    .newsletter h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 32px;
        font-weight: 400;
        margin: 12px 0;
    }

    .newsletter p {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
    }

    .site-footer {
        background: var(--dark);
        color: #f8f2e9;
        padding: 45px 6% 25px;
    }

    .footer-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 30px;
        flex-wrap: wrap;
        padding-bottom: 35px;
    }

    .footer-brand {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 25px;
    }

    .footer-main p {
        color: #c9bcb1;
        font-size: 11px;
        line-height: 1.8;
        max-width: 300px;
    }

    .footer-links {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 11px;
        color: #e2d7cd;
    }

    .footer-bottom {
        border-top: 1px solid #51443c;
        padding-top: 20px;
        font-size: 10px;
        color: #c9bcb1;
        display: flex;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
    }

    @media (max-width: 850px) {
        .main-nav { gap: 14px; }
        .hero-copy { padding: 50px 8%; }
        .category-image, .product-image { height: 240px; }
    }

    @media (max-width: 650px) {
        .header-main {
            padding: 20px 0;
            flex-direction: column;
        }

        .main-nav {
            justify-content: center;
            flex-wrap: wrap;
            font-size: 11px;
        }

        .header-link { display: none; }

        .hero { grid-template-columns: 1fr; }

        .hero-copy {
            padding: 55px 8%;
            text-align: center;
            align-items: center;
        }

        .hero-image, .hero-image img { min-height: 330px; }

        .categories, .products {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .category-image, .product-image { height: 340px; }

        .editorial { grid-template-columns: 1fr; }

        .editorial-image, .editorial-image img { min-height: 320px; }

        .editorial-copy { padding: 45px 8%; }

        .intro { padding-top: 55px; }

        .products-section { padding: 55px 7%; }
    }
</style>

<div class="announcement">
    UNE BEAUTÉ QUI VOUS RESSEMBLE · DES RITUELS PENSÉS POUR VOUS
</div>

<header class="site-header">
    <div class="header-main">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Maison Éclat, accueil">
            <svg class="brand-mark" viewBox="0 0 48 48" role="img" aria-label="Emblème floral">
                <g fill="none" stroke="#96754b" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 4 C19 11 19 16 24 20 C29 16 29 11 24 4Z"/>
                    <path d="M24 20 C17 14 12 15 11 21 C16 26 21 25 24 20Z"/>
                    <path d="M24 20 C31 14 36 15 37 21 C32 26 27 25 24 20Z"/>
                    <path d="M24 20 C18 25 18 31 24 35 C30 31 30 25 24 20Z"/>
                    <path d="M24 35 L24 43 M19 39 L24 35 L29 39"/>
                    <circle cx="24" cy="20" r="2.1"/>
                </g>
            </svg>
            <span>
                <span class="brand-name">Maison Éclat</span>
                <span class="brand-tagline">Beauté · Soin · Éclat</span>
            </span>
        </a>

        <nav class="main-nav" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="#categories">Nos univers</a>
            <a href="#produits">Nos produits</a>
            <a href="#histoire">Notre philosophie</a>
        </nav>

        <a class="header-link" href="#produits">Découvrir la collection</a>
    </div>
</header>

<main>
    <section class="hero">
        <div class="hero-copy">
            <span class="eyebrow">L'élégance au quotidien</span>

            <h1>Le luxe de prendre soin de soi.</h1>

            <p>
                Des essentiels beauté soigneusement sélectionnés,
                des textures délicates et des rituels qui transforment
                les petits gestes en véritables moments pour soi.
            </p>

            <a class="button" href="#produits">Explorer la collection</a>
        </div>

        <div class="hero-image">
            <img
                src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=1400&q=85"
                alt="Produits de soin dans une composition élégante"
                fetchpriority="high"
            >
        </div>
    </section>

    <section id="categories">
        <div class="intro">
            <span class="eyebrow">L'art du soin</span>
            <h2>Découvrez nos univers</h2>
            <p>
                Des indispensables sélectionnés pour accompagner
                chaque moment de votre routine beauté.
            </p>
        </div>

        <div class="categories">
            <a class="category-card" href="#produits">
                <div class="category-image">
                    <img
                        src="https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&fit=crop&w=850&q=85"
                        alt="Soins et cosmétiques pour le visage"
                        loading="lazy"
                    >
                </div>
                <div class="category-meta">
                    <h3>Soins du visage</h3>
                    <span aria-hidden="true">↗</span>
                </div>
            </a>

            <a class="category-card" href="#produits">
                <div class="category-image">
                    <img
                        src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=850&q=85"
                        alt="Univers du maquillage"
                        loading="lazy"
                    >
                </div>
                <div class="category-meta">
                    <h3>Maquillage</h3>
                    <span aria-hidden="true">↗</span>
                </div>
            </a>

            <a class="category-card" href="#produits">
                <div class="category-image">
                    <img
                        src="https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=850&q=85"
                        alt="Produits de soin et de bien-être"
                        loading="lazy"
                    >
                </div>
                <div class="category-meta">
                    <h3>Soins du corps</h3>
                    <span aria-hidden="true">↗</span>
                </div>
            </a>
        </div>
    </section>

    <section class="products-section" id="produits">
        <div class="section-heading">
            <span class="eyebrow">Nos essentiels</span>
            <h2>La sélection beauté</h2>
            <p>
                Quelques incontournables pour commencer votre rituel.
                Les références ci-dessous sont provisoires.
            </p>
        </div>


        <div class="products">
            {% for produit in produits %}
                {% set photo = produit.images|default([])|first %}

                <article class="product-card">
                    <div class="product-image">
                        {% if photo and photo.url is defined %}
                            <img
                                src="http://localhost:1337{{ photo.url }}"
                                alt="{{ produit.titre|default('Produit beauté') }}"
                                loading="lazy"
                            >
                        {% else %}
                            <img
                                src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=800&q=85"
                                alt="Produit de beauté"
                                loading="lazy"
                            >
                        {% endif %}

                        <span class="product-tag">Les essentiels</span>
                    </div>

                    <div class="product-info">
                        <span class="product-category">Soins de beauté</span>

                        <h3>{{ produit.titre|default('Produit beauté') }}</h3>

                        <p class="product-description">
                            {{ produit.description|default('Découvrez cet essentiel beauté.') }}
                        </p>

                        <div class="product-bottom">
                            <span class="price">Prix à définir</span>
                            <a href="#categories" class="product-link">
                                En savoir plus ↗
                            </a>
                        </div>
                    </div>
                </article>
            {% else %}
                <p>Les produits ne sont pas disponibles pour le moment.</p>
            {% endfor %}
        </div>
    </section>

    <section class="editorial" id="histoire">
        <div class="editorial-image">
            <img
                src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?auto=format&fit=crop&w=1200&q=85"
                alt="Composition éditoriale de produits cosmétiques"
                loading="lazy"
            >
        </div>

        <div class="editorial-copy">
            <span class="eyebrow">Notre philosophie</span>
            <h2>La beauté se vit dans les détails.</h2>
            <p>
                Nous croyons aux gestes simples, aux produits choisis
                avec attention et au plaisir de prendre du temps pour soi.
                Notre univers célèbre une beauté personnelle, douce et intemporelle.
            </p>
            <a class="button" href="#categories">Découvrir nos univers</a>
        </div>
    </section>

    <section class="newsletter">
        <span class="eyebrow">Un instant pour vous</span>
        <h2>Bienvenue dans notre univers.</h2>
        <p>
            Explorez nos inspirations beauté et composez votre propre rituel.
        </p>
        <a class="button" href="#produits">Voir la collection</a>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-main">
        <div>
            <a href="{{ path('app_home') }}" class="footer-brand-logo" aria-label="Maison Éclat, accueil">
                <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
                    <g fill="none" stroke="#c6a77f" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M24 4 C19 11 19 16 24 20 C29 16 29 11 24 4Z"/>
                        <path d="M24 20 C17 14 12 15 11 21 C16 26 21 25 24 20Z"/>
                        <path d="M24 20 C31 14 36 15 37 21 C32 26 27 25 24 20Z"/>
                        <path d="M24 20 C18 25 18 31 24 35 C30 31 30 25 24 20Z"/>
                        <path d="M24 35 L24 43 M19 39 L24 35 L29 39"/>
                        <circle cx="24" cy="20" r="2.1"/>
                    </g>
                </svg>
                <span>
                    <span class="brand-name">Maison Éclat</span>
                    <span class="brand-tagline">Beauté · Soin · Éclat</span>
                </span>
            </a>
            <p>
                Votre univers beauté, entre élégance, douceur
                et plaisir de prendre soin de soi.
            </p>
        </div>

        <nav class="footer-links" aria-label="Navigation de pied de page">
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="#categories">Nos univers</a>
            <a href="#produits">Nos produits</a>
            <a href="#histoire">Notre philosophie</a>
        </nav>
    </div>

    <div class="footer-bottom">
        <span>© {{ "now"|date("Y") }} Maison Éclat</span>
        <span>Une beauté qui vous ressemble.</span>
    </div>
</footer>
{% endblock %}
