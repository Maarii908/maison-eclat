<div class="cart-overlay" id="cartOverlay"></div>

<aside class="cart-panel" id="cartPanel" aria-label="Mon panier" aria-hidden="true">
    <div class="cart-header">
        <h2>Mon panier</h2>
        <button type="button" class="cart-close" id="closeCart" aria-label="Fermer">
            &times;
        </button>
    </div>

    <div class="cart-items" id="cartItems">
        <p class="cart-empty">Votre panier est vide.</p>
    </div>

    <div class="cart-footer">
        <div class="cart-total">
            <span>Total</span>
            <span id="cartTotal">0,00 €</span>
        </div>
        <button type="button" class="cart-validate" id="validateCart">Valider le panier</button>
    </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const openCart = document.getElementById('openCart');
    const closeCart = document.getElementById('closeCart');
    const validateCart = document.getElementById('validateCart');
    const cartPanel = document.getElementById('cartPanel');
    const cartOverlay = document.getElementById('cartOverlay');
    const cartItems = document.getElementById('cartItems');
    const cartCount = document.getElementById('cartCount');
    const cartTotal = document.getElementById('cartTotal');

    const contentUrl = "{{ path('panier_contenu') }}";
    const addUrlTemplate = "{{ path('panier_ajouter', {documentId: 'DOCUMENT_ID'}) }}";
    const decreaseUrlTemplate = "{{ path('panier_diminuer', {documentId: 'DOCUMENT_ID'}) }}";
    const removeUrlTemplate = "{{ path('panier_supprimer', {documentId: 'DOCUMENT_ID'}) }}";

    // Retire uniquement le paramètre de provenance s'il est présent dans l'adresse.
    const currentUrl = new URL(window.location.href);
    if (currentUrl.searchParams.has('utm_source')) {
        currentUrl.searchParams.delete('utm_source');
        window.history.replaceState({}, document.title, currentUrl.pathname + currentUrl.search + currentUrl.hash);
    }

    function ouvrirPanier() {
        cartPanel.classList.add('active');
        cartOverlay.classList.add('active');
        cartPanel.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    }

    function fermerPanier() {
        cartPanel.classList.remove('active');
        cartOverlay.classList.remove('active');
        cartPanel.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }

    function formaterPrix(prix) {
        return Number(prix || 0).toLocaleString('fr-FR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }) + ' €';
    }

    function creerBoutonQuantite(texte, action, documentId, label) {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.textContent = texte;
        bouton.dataset.action = action;
        bouton.dataset.documentId = documentId;
        bouton.setAttribute('aria-label', label);
        return bouton;
    }

    function afficherPanier(data) {
        const produits = Array.isArray(data.produits) ? data.produits : [];
        cartCount.textContent = data.nombreArticles || 0;
        cartTotal.textContent = formaterPrix(data.total);
        cartItems.innerHTML = '';

        if (produits.length === 0) {
            cartItems.innerHTML = '<p class="cart-empty">Votre panier est vide.</p>';
            return;
        }

        produits.forEach(function (produit) {
            const article = document.createElement('article');
            article.className = 'cart-item';

            if (produit.image) {
                const image = document.createElement('img');
                image.src = produit.image.startsWith('http')
                    ? produit.image
                    : 'http://localhost:1337' + produit.image;
                image.alt = produit.titre || 'Produit beauté';
                image.className = 'cart-product-image';
                article.appendChild(image);
            }

            const details = document.createElement('div');
            details.className = 'cart-product-details';

            const titre = document.createElement('h3');
            titre.textContent = produit.titre || 'Produit beauté';

            const prix = document.createElement('p');
            prix.textContent = formaterPrix(produit.prix);

            const quantite = document.createElement('div');
            quantite.className = 'cart-quantity';
            quantite.appendChild(creerBoutonQuantite('−', 'decrease', produit.documentId, 'Diminuer la quantité'));

            const nombre = document.createElement('span');
            nombre.textContent = produit.quantite;
            quantite.appendChild(nombre);
            quantite.appendChild(creerBoutonQuantite('+', 'increase', produit.documentId, 'Augmenter la quantité'));

            const sousTotal = document.createElement('p');
            sousTotal.textContent = 'Sous-total : ' + formaterPrix(produit.sousTotal);

            details.append(titre, prix, quantite, sousTotal);

            const supprimer = document.createElement('button');
            supprimer.type = 'button';
            supprimer.className = 'cart-delete';
            supprimer.dataset.action = 'delete';
            supprimer.dataset.documentId = produit.documentId;
            supprimer.setAttribute('aria-label', 'Supprimer ' + (produit.titre || 'ce produit'));
            supprimer.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 14h12l1-14M9 7V4h6v3"/></svg>';

            article.append(details, supprimer);
            cartItems.appendChild(article);
        });
    }

    async function envoyerAction(url) {
        const response = await fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (!response.ok) throw new Error('La mise à jour du panier a échoué.');
        const data = await response.json();
        if (data.success && data.panier) afficherPanier(data.panier);
        return data;
    }

    async function chargerPanier() {
        try {
            const response = await fetch(contentUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error('Impossible de charger le panier.');
            afficherPanier(await response.json());
        } catch (error) {
            console.error(error);
        }
    }

    openCart.addEventListener('click', ouvrirPanier);
    closeCart.addEventListener('click', fermerPanier);
    cartOverlay.addEventListener('click', fermerPanier);
    validateCart.addEventListener('click', fermerPanier);

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') fermerPanier();
    });

    document.querySelectorAll('.add-cart-button').forEach(function (bouton) {
        bouton.addEventListener('click', async function () {
            const documentId = bouton.dataset.documentId;
            if (!documentId) return;
            const url = addUrlTemplate.replace('DOCUMENT_ID', encodeURIComponent(documentId));
            bouton.disabled = true;
            try {
                const data = await envoyerAction(url);
                if (data.success) ouvrirPanier();
                else alert(data.message || 'Impossible d’ajouter ce produit.');
            } catch (error) {
                console.error(error);
                alert('Impossible de mettre à jour le panier.');
            } finally {
                bouton.disabled = false;
            }
        });
    });

    cartItems.addEventListener('click', async function (event) {
        const bouton = event.target.closest('button[data-action]');
        if (!bouton) return;

        const documentId = bouton.dataset.documentId;
        const templates = {
            increase: addUrlTemplate,
            decrease: decreaseUrlTemplate,
            delete: removeUrlTemplate
        };
        const template = templates[bouton.dataset.action];
        if (!template) return;

        bouton.disabled = true;
        try {
            await envoyerAction(template.replace('DOCUMENT_ID', encodeURIComponent(documentId)));
        } catch (error) {
            console.error(error);
            alert('Impossible de mettre à jour le panier.');
        } finally {
            bouton.disabled = false;
        }
    });

    chargerPanier();
});
</script>

{% endblock %}
